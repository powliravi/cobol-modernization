//TXNPROC PROC HLQ=MY.APP
//BATCH   EXEC PGM=TXNBATCH
//STEPLIB DD  DSN=&HLQ..LOAD,DISP=SHR
//TXNIN   DD  DSN=&HLQ..TXN.INPUT(0),DISP=SHR
//TXNOUT  DD  DSN=&HLQ..TXN.AUDIT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1),RLSE),
//             DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=0)
// PEND