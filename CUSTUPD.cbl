       >>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CUSTUPD.
DATA DIVISION.
WORKING-STORAGE SECTION.
EXEC SQL INCLUDE SQLCA END-EXEC.
EXEC SQL BEGIN DECLARE SECTION END-EXEC.
01 WS-CREDIT-AMOUNT                 PIC S9(7)V99 COMP-3 VALUE 125.50.
    COPY DCLCUSTOM.
EXEC SQL END DECLARE SECTION END-EXEC.
PROCEDURE DIVISION.
MAIN.
    MOVE 'ACCT000001' TO DCL-CUSTOMER-ID
    EXEC SQL
        SELECT BALANCE
          INTO :DCL-CUSTOMER-BALANCE
          FROM CUSTOMER
         WHERE CUSTOMER_ID = :DCL-CUSTOMER-ID
         FOR UPDATE
    END-EXEC
    IF SQLCODE NOT = 0
        PERFORM SQL-FAILURE
    END-IF

        ADD WS-CREDIT-AMOUNT TO DCL-CUSTOMER-BALANCE
    EXEC SQL
        UPDATE CUSTOMER
                     SET BALANCE = :DCL-CUSTOMER-BALANCE
                 WHERE CUSTOMER_ID = :DCL-CUSTOMER-ID
    END-EXEC
    IF SQLCODE NOT = 0
        PERFORM SQL-FAILURE
    END-IF

    EXEC SQL COMMIT END-EXEC
    IF SQLCODE NOT = 0
        PERFORM SQL-FAILURE
    END-IF
    DISPLAY 'DB2-UPDATE-OK|' DCL-CUSTOMER-ID
    GOBACK.

SQL-FAILURE.
    DISPLAY 'DB2-ERROR|' SQLCODE
    EXEC SQL ROLLBACK END-EXEC
    MOVE 12 TO RETURN-CODE
    GOBACK.